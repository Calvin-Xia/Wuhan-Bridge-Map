---
import "../styles/global.css";

const title = "桥见江城：武汉桥梁群实践数字地图";
const description = "从一桥一问看工程报国、城市治理与民生获得感";
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let storedTheme = null;

        try {
          storedTheme = window.localStorage.getItem("wuhan-bridge-map-theme");
        } catch {
          storedTheme = null;
        }

        const savedTheme = storedTheme === "light" || storedTheme === "dark" ? storedTheme : null;
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const theme = savedTheme ?? systemTheme;

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <main class="app-shell">
      <section class="map-stage page-enter" id="section-map" aria-label="武汉桥梁群地图">
        <header class="map-header">
          <p class="kicker">武汉桥梁群 · 大思政实践</p>
          <h1>{title}</h1>
          <p class="page-summary">{description}</p>
          <nav class="header-nav" aria-label="页面分区跳转">
            <a href="#section-map">地图·一桥一问</a>
            <a href="#section-evidence">问卷证据</a>
            <a href="#section-voices">市民之声</a>
            <a href="#section-governance">治理侧记</a>
          </nav>
          <div class="header-side">
            <dl class="metric-strip" aria-label="项目指标">
              <div><dt>座桥</dt><dd><strong id="bridge-count">8</strong></dd><small class="metric-code">BRIDGES</small></div>
              <div><dt>条路线</dt><dd><strong>4</strong></dd><small class="metric-code">ROUTES</small></div>
              <div title="公开资料 · 问卷封闭题 · 问卷开放题 · 团队实地记录 · 机构访谈">
                <dt>类证据</dt><dd><strong>5</strong></dd><small class="metric-code">EVIDENCE</small>
              </div>
            </dl>
            <button
              id="theme-toggle"
              class="theme-toggle"
              type="button"
              aria-pressed="false"
              aria-label="切换到暗夜主题"
            >
              <span class="theme-toggle-label" data-theme-toggle-label>暗夜</span>
            </button>
          </div>
        </header>

        <section class="workspace" aria-label="桥梁地图工作区">
          <aside class="story-rail" aria-label="桥梁调研内容">
            <nav class="bridge-index" aria-label="桥梁目录">
              <p class="section-label">一桥一问</p>
              <ul id="bridge-list" class="bridge-list" aria-busy="true">
                <li class="bridge-skeleton" aria-hidden="true"></li>
                <li class="bridge-skeleton" aria-hidden="true"></li>
                <li class="bridge-skeleton" aria-hidden="true"></li>
              </ul>
            </nav>
          </aside>

          <section class="map-column" aria-label="交互地图">
            <div id="bridge-map" class="map-canvas"></div>
            <aside class="map-legend" id="map-legend" aria-label="路线图例">
              <button
                class="map-legend-toggle"
                id="map-legend-toggle"
                type="button"
                aria-expanded="true"
                aria-controls="map-legend-content"
              >
                <span class="map-legend-title">路线图例</span>
                <span class="map-legend-chevron" aria-hidden="true"></span>
              </button>
              <div class="map-legend-content" id="map-legend-content">
                <ul id="map-legend-list" class="map-legend-list" aria-busy="true"></ul>
                <p class="map-legend-note">点位间为直线示意，非实际步行路径。</p>
              </div>
            </aside>
            <p id="map-status" class="map-status" role="status">地图与点位数据载入中</p>
          </section>
        </section>
      </section>

      <section class="evidence-band" id="section-evidence" aria-label="问卷与调研证据">
        <header class="evidence-heading reveal">
          <p class="section-label">问卷与开放题证据</p>
          <h2>认知、价值与治理期待：两份问卷的交叉印证</h2>
          <p class="evidence-lead">
            网络版《桥梁、城市与公众生活调查》230 份进入、228 份有效，覆盖武汉及全国；现场版《武汉桥梁与桥下公共空间公众体验调查》59 份提交、57 份有效，覆盖 7 座桥梁点位。样本均为便利抽样，结果用于描述本次受访者，不作总体推断。
          </p>
        </header>
        <section class="chart-grid" aria-label="认知与价值问卷图表">
          <figure class="chart-block reveal">
            <figcaption>
              <span class="chart-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M5 19V9m7 10V5m7 14v-7" /></svg>
              </span>
              <span>最熟悉的桥梁</span>
            </figcaption>
            <p class="chart-note">网络版 n=182（与武汉有到访联系者）；现场版 57 份中武汉长江大桥同样居首（57.89%）。</p>
            <div id="chart-familiar" class="chart-canvas" role="img" aria-label="最熟悉桥梁柱状图"></div>
          </figure>
          <figure class="chart-block reveal">
            <figcaption>
              <span class="chart-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M12 3a9 9 0 1 0 9 9h-9V3Z" /><path d="M15 3.5A9 9 0 0 1 20.5 9H15V3.5Z" /></svg>
              </span>
              <span>桥梁信息来源</span>
            </figcaption>
            <p class="chart-note">网络版 n=228，最多选 4 项，各项占比之和可超过 100%。</p>
            <div id="chart-sources" class="chart-canvas" role="img" aria-label="桥梁信息来源横向条形图"></div>
          </figure>
          <figure class="chart-block reveal">
            <figcaption>
              <span class="chart-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="m4 16 5-5 4 3 7-8M4 20h16" /></svg>
              </span>
              <span>桥梁公共价值认同</span>
            </figcaption>
            <p class="chart-note">网络版 n=228，有效评分正向率（4—5 分占比），悬浮查看均值。</p>
            <div id="chart-value" class="chart-canvas" role="img" aria-label="桥梁公共价值认同柱状图"></div>
          </figure>
        </section>
        <section class="chart-grid chart-grid--pair" aria-label="治理需求问卷图表">
          <figure class="chart-block reveal">
            <figcaption>
              <span class="chart-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="1.4" /><path d="M8.7 8.7a4.7 4.7 0 0 1 6.6 0M5.6 5.6a9 9 0 0 1 12.8 0" /></svg>
              </span>
              <span>科技治理期待</span>
            </figcaption>
            <p class="chart-note">网络版 n=228，限选 2 项。</p>
            <div id="chart-tech" class="chart-canvas" role="img" aria-label="科技治理期待横向条形图"></div>
          </figure>
          <figure class="chart-block reveal">
            <figcaption>
              <span class="chart-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><rect x="6" y="4" width="12" height="17" rx="2" /><path d="M9.5 4V2.5h5V4M9.5 13.5l2 2 3.5-4" /></svg>
              </span>
              <span>近期改善优先级</span>
            </figcaption>
            <p class="chart-note">网络版 n=228，限选 2 项。</p>
            <div id="chart-improve" class="chart-canvas" role="img" aria-label="近期改善优先级柱状图"></div>
          </figure>
        </section>
        <section class="chart-grid chart-grid--pair" aria-label="开放题主题图表">
          <figure class="chart-block reveal">
            <figcaption>
              <span class="chart-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M4 5h16v11h-6l-4 3v-3H4V5Z" /></svg>
              </span>
              <span>开放题主题：网络版</span>
            </figcaption>
            <p class="chart-note">第 20 题 72 条实质回答（占 228 份的 31.58%），多重主题编码，占比之和可超过 100%。</p>
            <div id="chart-open-online" class="chart-canvas" role="img" aria-label="网络版开放题主题横向条形图"></div>
          </figure>
          <figure class="chart-block reveal">
            <figcaption>
              <span class="chart-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M4 5h16v11h-6l-4 3v-3H4V5Z" /></svg>
              </span>
              <span>开放题主题：现场版</span>
            </figcaption>
            <p class="chart-note">第 18 题 22 条实质回答（占 57 份的 38.60%），每条仅计一个主主题；原始记录未附点位。</p>
            <div id="chart-open-field" class="chart-canvas" role="img" aria-label="现场版开放题主题横向条形图"></div>
          </figure>
        </section>
        <div class="tail-grid">
          <section class="voice-band" id="section-voices" aria-label="市民之声">
            <header class="evidence-heading reveal">
              <p class="section-label">市民之声</p>
              <h2>问卷里的市民之声</h2>
              <p class="evidence-lead">
                八座桥被千万次路过，这一次轮到路过的人开口。以下是问卷里市民关于桥的想法——一句抱怨、一次期待、一段记忆
              </p>
            </header>
            <div class="voice-group">
              <h3>网络版问卷 · 第 20 题（72 条实质回答）</h3>
              <ul id="voice-list-online" class="voice-list" aria-busy="true"></ul>
            </div>
            <div class="voice-group">
              <h3>现场版问卷 · 第 18 题（22 条实质回答）</h3>
              <ul id="voice-list-field" class="voice-list" aria-busy="true"></ul>
            </div>
          </section>
          <section class="governance-band" id="section-governance" aria-label="治理侧记" aria-busy="true">
            <header class="governance-heading reveal">
              <p class="section-label">治理侧记</p>
              <h2>从日常巡护到智慧治理</h2>
              <p class="evidence-lead" id="governance-intro">正在读取治理数据……</p>
            </header>
            <p class="section-label governance-subheading">数字里的日常</p>
            <ul id="governance-stat-groups" class="governance-stat-groups" aria-busy="true"></ul>
            <p class="section-label governance-subheading">负责人这样说</p>
            <ul id="governance-quotes" class="governance-quotes" aria-busy="true"></ul>
          </section>
        </div>

        <footer class="site-footer" aria-label="数据口径与来源">
          <div class="footer-filing">
            <p class="footer-identity">桥见江城 · 武汉桥梁群实践数字地图</p>
            <p class="footer-note-label">数据口径与来源</p>
            <ul id="governance-disclaimers" class="governance-disclaimers"></ul>
            <p class="footer-beian">
              <a
                class="beian-link"
                href="https://beian.miit.gov.cn/"
                target="_blank"
                rel="noopener noreferrer"
              >渝ICP备2026000319号</a>
              <a
                class="beian-link beian-link--police"
                href="https://www.beian.gov.cn/portal/registerSystemInfo?recordcode=50010102001439"
                target="_blank"
                rel="noopener noreferrer"
              >
                <img
                  class="beian-badge"
                  src="/beian-badge.png"
                  alt=""
                  width="16"
                  height="18"
                  loading="lazy"
                />
                <span>渝公网安备50010102001439号</span>
              </a>
            </p>
          </div>
        </footer>
      </section>
    </main>

    <!-- 故事卡弹窗（body 直属，全端统一）：面板 + 背景层；
         fixed 定位锚定视口，与页面结构零耦合。 -->
    <article id="story-panel" class="story-panel" aria-live="polite">
      <!-- 顶部条 = 卡片内首行（全端统一）：返回按钮 + 当前点位胶囊。 -->
      <div class="story-modal-bar" id="story-modal-bar">
        <button class="story-modal-close" id="story-modal-close" type="button" aria-label="返回地图">
          <span class="story-modal-chevron" aria-hidden="true"></span>
        </button>
        <span class="story-modal-context" id="story-modal-context">当前点位</span>
      </div>
      <div id="story-panel-content">
        <p class="section-label">当前点位</p>
        <h2>数据载入中</h2>
        <p>正在读取桥梁点位、故事卡片和资料索引。</p>
      </div>
    </article>
    <!-- 弹窗背景层：全屏高斯模糊 + 压暗（地图容器 filter 原生实现，无第三方库）；
         点击背景区域同样关闭弹窗。 -->
    <div class="story-modal-backdrop" id="story-modal-backdrop" aria-hidden="true"></div>

    <!-- 首次引导提示：点桥即打开故事卡（会话级一次，自动消退/可关闭）。 -->
    <aside class="story-hint" id="story-hint" role="status" hidden>
      <p>点击目录或地图上的桥点，查看该桥的故事卡</p>
      <button class="story-hint-close" id="story-hint-close" type="button" aria-label="关闭提示">×</button>
    </aside>

    <script>
      void (async () => {
        await import("../scripts/theme");
        await Promise.all([
          import("../scripts/map-app"),
          import("../scripts/charts"),
          import("../scripts/voices"),
          import("../scripts/governance"),
          import("../scripts/reveal"),
        ]);
      })().catch((error) => {
        console.error("Failed to load interactive modules", error);
      });
    </script>
  </body>
</html>
